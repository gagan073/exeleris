# Copy this file to .env and fill in the two values from your Supabase project.
# In Supabase: Project Settings -> Data API -> Project URL / anon public key.
# Full walkthrough: see SETUP_GUIDE.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Turns the "Upload your deliverable, we'll draft your listing" AI feature on.
# Leave blank (or "false") to keep it hidden. Set to "true" only AFTER you have
# deployed the analyze-deliverable Edge Function and added your ANTHROPIC_API_KEY
# secret in Supabase. Full walkthrough: see AI_FEATURE_SETUP.md
# NOTE: the Anthropic API key is NEVER put here — it lives only in Supabase.
VITE_ENABLE_AI_ANALYSIS=false
